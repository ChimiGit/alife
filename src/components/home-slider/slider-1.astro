  <p
  class="text-primary max-w-xs sm:max-w-md md:max-w-xl lg:max-w-2xl font-light mt-6 sm:mt-8 lg:mt-10 text-base md:text-lg"
  style={`font-family: ${
    "'Inter', sans-serif"
  }; line-height: 150%;`}
  >
  We're cultivating alternative pathways to intelligence through evolution itself—creating systems that don't just optimize, but discover, surprise, and continuously evolve, just like the nature. This is where we pave a way for a future not engineered, but grown organically through bottom-up approaches where humans and artificial life forms collaborate toward digital democracy and a more diverse AI ecosystem.</p>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Set up the canvas and other variables
    const canvas = document.getElementById('particleCanvas');
    const ctx = canvas?.getContext('2d', { 
      alpha: false, // Opaque canvas = better performance
      desynchronized: true // Reduces latency
    });
      
    if (!ctx || !canvas) return;
    
    let lines = [];
    let animationFrameId = null;
    let isResizing = false;
    let lastTime = 0;
    
    // Performance optimizations
    const isMobile = () => window.innerWidth <= 768;
    const isLowEnd = () => {
      const memory = navigator.deviceMemory;
      const cores = navigator.hardwareConcurrency;
      return (memory && memory < 4) || (cores && cores <= 2);
    };
    
    // Adaptive settings based on device capability
    const getSettings = () => {
      const mobile = isMobile();
      const lowEnd = isLowEnd();
      
      return {
        particleRadius: mobile ? 1.5 : 1.7,
        baseLineSpeed: 2.0,
        baseLineSpread: mobile ? 120 : 200,
        // Keep original particle count as requested
        baseDensity: 2000,
        lineSeparation: mobile ? 150 : 210,
        mobileMultiplier: mobile ? 0.6 : 1,
        // Lower DPR on low-end devices for better performance
        dpr: lowEnd ? 1 : Math.min(window.devicePixelRatio || 1, 2)
      };
    };
    
    let settings = getSettings();

    function resizeCanvas() {
        if (!ctx || !canvas) return;
        
        isResizing = true;
        
        if (animationFrameId !== null) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
        
        // Refresh settings on resize
        settings = getSettings();
        const dpr = settings.dpr;
        
        const oldWidth = canvas.width > 0 ? canvas.width / dpr : window.innerWidth;
        const oldHeight = canvas.height > 0 ? canvas.height / dpr : window.innerHeight;
        
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.scale(dpr, dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;

        // Only scale existing lines if we have them and old dimensions are valid
        if (lines.length > 0 && oldWidth > 0 && oldHeight > 0) {
          const scaleX = window.innerWidth / oldWidth;
          const scaleY = window.innerHeight / oldHeight;
          
          lines.forEach((line) => {
            line.xOffset *= scaleX;
            line.particles.forEach((p) => {
              p.y *= scaleY;
            });
          });
        } else {
          // Initialize lines if we don't have any
          lines = [];
        }

        const centerX = isMobile() ? 0 : window.innerWidth / 2 + 40;
        const adjustedLineSeparation = settings.lineSeparation * settings.mobileMultiplier;
        const numRequiredLines = Math.ceil(window.innerWidth / adjustedLineSeparation) + 2;
        
        if (lines.length < numRequiredLines) {
          const linesToAdd = numRequiredLines - lines.length;
          for (let i = 0; i < linesToAdd; i++) {
            const line = createLine(1);
            const lastLine = lines[lines.length - 1];
            line.xOffset = lastLine ? lastLine.xOffset + adjustedLineSeparation : centerX;
            lines.push(line);
          }
        }
        
        if (lines.length > numRequiredLines + 2) {
          lines = lines.slice(0, numRequiredLines + 2);
        }

        isResizing = false;
        lastTime = 0;
        
        // Always restart animation after resize
        if (!document.hidden) {
          animationFrameId = requestAnimationFrame(animate);
        }
    }

    // Use object literals instead of class for better performance
    function createParticle(relativeX, y, speedY) {
      return { relativeX, y, speedY };
    }
    
    // Inline particle update for better performance
    function updateParticle(p, deltaFactor, canvasHeight) {
      // No-op: particles are static to maximize smoothness
    }
    
    function createLine(direction = 1) {
      const particles = [];
      const adjustedDensity = Math.floor(settings.baseDensity * settings.mobileMultiplier);
      
      // Pre-allocate array for better performance
      particles.length = adjustedDensity;
      
      for (let j = 0; j < adjustedDensity; j++) {
        const randomX = Math.pow(Math.random(), 0.5);
        const y = Math.random() * window.innerHeight;
        const speedY = (Math.random() - 0.5) * 1.0;
        particles[j] = createParticle(randomX, y, speedY);
      }

      return {
        xOffset: isMobile() ? 0 : window.innerWidth / 2 + 40,
        speed: settings.baseLineSpeed * direction,
        particles,
        opacity: 1,
        startX: isMobile() ? 0 : window.innerWidth / 2 + 40,
      };
    }

    function animate(currentTime = 0) {
      if (!ctx || !canvas) {
        return;
      }
      
      if (isResizing) {
        animationFrameId = requestAnimationFrame(animate);
        return;
      }
      
      // Calculate delta time for consistent speed
      const deltaTime = lastTime ? currentTime - lastTime : 16.67;
      lastTime = currentTime;
      const normalizedDelta = Math.min(deltaTime / 16.67, 2);
      
      // Use fillRect instead of clearRect - slightly faster
      ctx.fillStyle = '#FBEC61';
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      // Cache frequently used values
      const mobile = isMobile();
      const mobileMultiplier = settings.mobileMultiplier;
      const adjustedLineSeparation = settings.lineSeparation * mobileMultiplier;
      const startX = mobile ? 0 : window.innerWidth / 2 + 40;
      const currentLineSpread = settings.baseLineSpread * mobileMultiplier;
      const particleSize = settings.particleRadius * mobileMultiplier;
      const canvasHeight = canvas.height;
      const canvasWidth = window.innerWidth;
      
      // Create new lines as we advance, keeping consistent spacing from startX
      if (lines.length === 0) {
        lines.push(createLine(1));
      } else {
        const lastLine = lines[lines.length - 1];
        const distanceFromStart = lastLine.xOffset - startX;
        if (distanceFromStart >= adjustedLineSeparation || (lines.length < 3 && distanceFromStart >= 0)) {
          lines.push(createLine(1));
        }
      }

      // Set global alpha once for particles
      const centerX = mobile ? 0 : canvasWidth / 2 + 40;
      const fadeInStart = centerX - currentLineSpread;
      const fadeInEnd = centerX;
      const fadeOutStart = canvasWidth - currentLineSpread;
      const fadeOutEnd = canvasWidth;

      // Batch rendering - set fill style once
      ctx.fillStyle = 'rgba(28, 165, 0, 1)';

      for (let i = lines.length - 1; i >= 0; i--) {
        const line = lines[i];
        line.xOffset += line.speed * mobileMultiplier * normalizedDelta;

        // Calculate opacity once per line
        let lineOpacity = 1;
        if (!mobile) {
          if (line.xOffset < fadeInEnd) {
            lineOpacity = Math.max(0, Math.min(1, (line.xOffset - fadeInStart) / (fadeInEnd - fadeInStart)));
          } else if (line.xOffset > fadeOutStart) {
            lineOpacity = Math.max(0, 1 - ((line.xOffset - fadeOutStart) / (fadeOutEnd - fadeOutStart)));
          }
        }
        
        // Skip invisible lines
        if (lineOpacity <= 0.01) {
          if (line.xOffset > canvasWidth + currentLineSpread) {
            lines.splice(i, 1);
          }
          continue;
        }

        // Set alpha for this line
        ctx.globalAlpha = lineOpacity;
        
        const particles = line.particles;
        const particleCount = particles.length;
        
        // Render particles - optimized loop
        for (let j = 0; j < particleCount; j++) {
          const p = particles[j];
          
          // Particles are static; skip per-frame vertical updates

          const xOffset = (p.relativeX * currentLineSpread) - (currentLineSpread / 2);
          const particleX = xOffset + line.xOffset;
          
          // Early skip for off-screen particles
          if (particleX < -currentLineSpread || particleX > canvasWidth + currentLineSpread) {
            continue;
          }

          // Use arc for circles - fastest way to draw circles
          ctx.beginPath();
          ctx.arc(particleX, p.y, particleSize, 0, Math.PI * 2);
          ctx.fill();
        }

        // Recycle off-screen lines instead of removing them to maintain cadence
        if (line.xOffset > canvasWidth + currentLineSpread) {
          let maxOther = startX;
          for (let k = 0; k < lines.length; k++) {
            if (k !== i) {
              maxOther = Math.max(maxOther, lines[k].xOffset);
            }
          }
          line.xOffset = maxOther + adjustedLineSeparation;
        }
      }

      // Reset global alpha
      ctx.globalAlpha = 1;

      if (!document.hidden && !isResizing) {
        animationFrameId = requestAnimationFrame(animate);
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && lines.length > 0 && !isResizing) {
        lastTime = 0;
        animationFrameId = requestAnimationFrame(animate);
      }
    });

    let resizeTimeout = null;
    window.addEventListener('resize', () => {
      if (resizeTimeout) {
        clearTimeout(resizeTimeout);
      }
      
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      
      resizeTimeout = setTimeout(() => {
        resizeCanvas();
      }, 150);
    });

    // Initial setup
    resizeCanvas();
  });
</script>