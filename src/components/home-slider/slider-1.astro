<div class="fixed inset-0 w-full h-full overflow-hidden bg-[#FBEC61]" style="font-family: 'Inter', sans-serif; position: fixed !important; width: 100vw !important; height: 100vh !important; min-height: 100vh !important;">
  <!-- Particle Animation Canvas -->
  <canvas id="particleCanvas" class="absolute inset-0 w-full h-full z-5" style="touch-action: none; background-color: transparent; image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges;"></canvas>

  <!-- Text Content -->
  <section class="absolute top-1/2 left-0 right-0 -translate-y-1/2 px-4 sm:px-6 z-[60]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h1
      class="text-6xl sm:text-64px md:text-64px lg:text-[96px] text-primary mt-10 md:mt-0"
      style={`font-family: ${
        "'GT Alpina Fine', serif"
      }; margin: 0; line-height: 90%;  letter-spacing: -0.05em;`}
    >
    Exploring Symbiosis
    </h1>
    <h1
    class="text-6xl sm:text-6xl md:text-64px lg:text-[96px] text-primary"
    style={`font-family: ${
      "'GT Alpina Fine', serif"
    }; margin: 0; line-height: 90%;  letter-spacing: -0.05em;`}
  >
    <span class="md:hidden">Between</span>
    <span class="hidden md:inline">Between All Forms of</span>
  </h1>
    <h1
    class="text-6xl sm:text-6xl md:text-64px lg:text-[96px] text-primary"
    style={`font-family: ${
      "'GT Alpina Fine'"
    }; margin: 0; line-height: 90%; letter-spacing: -0.05em;`}
  >
  <span class="md:hidden">All Forms of Intelligence</span>
  <span class="hidden md:inline">Intelligence</span>
  </h1>
  <p
  class="text-primary max-w-xs sm:max-w-md md:max-w-xl lg:max-w-2xl font-light mt-6 sm:mt-8 lg:mt-10 text-base md:text-lg"
  style={`font-family: ${
    "'Inter', sans-serif"
  }; line-height: 150%;`}
  >
  We’re cultivating alternative pathways to intelligence through evolution itself—creating systems that don’t just optimize, but discover, surprise, and continuously evolve, just like the nature. This is where we pave a way for a future not engineered, but grown organically through bottom-up approaches where humans and artificial life forms collaborate toward digital democracy and a more diverse AI ecosystem.</p>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Set up the canvas and other variables
    const canvas = document.getElementById('particleCanvas');
    const ctx = canvas.getContext('2d');
    
    if (!ctx || !canvas) return; // Exit if canvas context is not available
    
    let lines: any[] = [];
    let animationFrameId: number | null = null;
    let isResizing = false;
    let lastTime = 0;
    const particleRadius = 1.7;
    const baseLineSpeed = 2.0;
    const baseLineSpread = 200;
    const baseDensity = 2000;
    const lineSeparation = 210;
    
    // Mobile responsive adjustments
    const isMobile = () => window.innerWidth <= 768;
    const getMobileMultiplier = () => isMobile() ? 0.6 : 1; // 60% size on mobile

    function resizeCanvas() {
        if (!ctx || !canvas) return;
        
        isResizing = true;
        
        // Cancel any pending animation frame
        if (animationFrameId !== null) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
        
        const dpr = window.devicePixelRatio || 1;
        const oldWidth = canvas.width / dpr;
        const oldHeight = canvas.height / dpr;
        
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.scale(dpr, dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;

        // Adjust existing lines positions proportionally instead of recreating
        const scaleX = window.innerWidth / oldWidth;
        const scaleY = window.innerHeight / oldHeight;
        
        lines.forEach((line) => {
          line.xOffset = line.xOffset * scaleX;
          line.particles.forEach((p: any) => {
            p.y = p.y * scaleY;
          });
        });

        // Add or remove lines if needed based on new width
        const centerX = isMobile() ? 0 : window.innerWidth / 2 + 40;
        const mobileMultiplier = getMobileMultiplier();
        const adjustedLineSeparation = lineSeparation * mobileMultiplier;
        const numRequiredLines = Math.ceil(window.innerWidth / adjustedLineSeparation) + 2;
        
        // Add lines if we don't have enough
        if (lines.length < numRequiredLines) {
          const linesToAdd = numRequiredLines - lines.length;
          for (let i = 0; i < linesToAdd; i++) {
            const line = createLine(1);
            const lastLine = lines[lines.length - 1];
            line.xOffset = lastLine ? lastLine.xOffset + adjustedLineSeparation : centerX;
            lines.push(line);
          }
        }
        
        // Remove excess lines (keep only what's needed + 2 buffer)
        if (lines.length > numRequiredLines + 2) {
          lines = lines.slice(0, numRequiredLines + 2);
        }

        isResizing = false;
        lastTime = 0; // Reset time to prevent jump after resize
        
        // Resume animation
        if (!document.hidden) {
          animationFrameId = requestAnimationFrame(animate);
        }
    }

    class Particle {
      constructor(relativeX, y, speedY) {
        this.relativeX = relativeX;
        this.y = y;
        this.speedY = speedY;
      }

      // Update particle's position with gentle vertical movement
      update() {
        if (!canvas) return;
        this.y += this.speedY;
        // Smooth boundary wrapping instead of bouncing
        if (this.y < 0) {
          this.y = canvas.height;
        } else if (this.y > canvas.height) {
          this.y = 0;
        }
      }
    }
    
    // Helper function to create a single line of particles with a random speed
    function createLine(direction: number = 1) {
      const particles: Particle[] = [];
      const mobileMultiplier = getMobileMultiplier();
      const adjustedDensity = Math.floor(baseDensity * mobileMultiplier);
      for (let j = 0; j < adjustedDensity; j++) {
        const randomX = Math.pow(Math.random(), 0.5);
        const y = Math.random() * window.innerHeight;
        const speedY = (Math.random() - 0.5) * 1.0;
        particles.push(new Particle(randomX, y, speedY));
      }

      return {
      xOffset: isMobile() ? 0 : window.innerWidth / 2 + 40, // Start from left on mobile, center on desktop
      speed: baseLineSpeed * direction, // Direction: 1 for right, -1 for left
      particles,
      // Particles maintain constant opacity
      opacity: 1,
      startX: isMobile() ? 0 : window.innerWidth / 2 + 40,
      };
    }

    // Main animation loop - using time-based animation for smoothness
    function animate(currentTime: number = 0) {
      if (!ctx || !canvas || isResizing) {
        if (!document.hidden && !isResizing) {
          animationFrameId = requestAnimationFrame(animate);
        }
        return;
      }
      
      // Calculate delta time for consistent speed across different frame rates
      const deltaTime = lastTime ? currentTime - lastTime : 16.67; // Default to 60fps if first frame
      lastTime = currentTime;
      const normalizedDelta = Math.min(deltaTime / 16.67, 2); // Cap at 2x speed to prevent large jumps
      
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      // Add new line when the last line has moved a specific distance
      const mobileMultiplier = getMobileMultiplier();
      const adjustedLineSeparation = lineSeparation * mobileMultiplier;
      const startX = isMobile() ? 0 : window.innerWidth / 2 + 40; // Start from left on mobile, center on desktop
      
      // Smooth line creation based on distance, not frame count
      if (lines.length === 0) {
        lines.push(createLine(1));
      } else {
        const lastLine = lines[lines.length - 1];
        const distanceFromStart = lastLine.xOffset - startX;
        if (distanceFromStart >= adjustedLineSeparation || (lines.length < 3 && distanceFromStart >= 0)) {
          lines.push(createLine(1));
        }
      }

      // Update and draw each line
      for (let i = lines.length - 1; i >= 0; i--) {
        const line = lines[i];
        // Use delta time for smooth movement regardless of frame rate
        line.xOffset += line.speed * mobileMultiplier * normalizedDelta;

        // Calculate current spread and density based on distance from start position
        const centerX = isMobile() ? 0 : window.innerWidth / 2 + 40; // Use left edge on mobile, center on desktop
        const distanceFromCenter = Math.abs(line.xOffset - centerX);
        const maxDistance = isMobile() ? window.innerWidth : window.innerWidth / 2; // Full width on mobile, half on desktop
        const progress = distanceFromCenter / maxDistance;
        const currentLineSpread = baseLineSpread * mobileMultiplier;
        
        // Make right side denser by adjusting density calculation (only on desktop)
        const isRightSide = line.xOffset > centerX;
        let densityMultiplier;
        if (isMobile()) {
          densityMultiplier = 1; // Full density on mobile
        } else {
          densityMultiplier = isRightSide ? 150 : 0; // Right-side bias on desktop
        }
        const currentDensity = isMobile() ? baseDensity * mobileMultiplier : baseDensity * (1 - progress) * densityMultiplier;

        const particlesToDraw = Math.floor(currentDensity);
        
        // Particles maintain constant opacity - no fading
        line.opacity = 1;

        line.particles.slice(0, particlesToDraw).forEach((p: any) => {
          // Smooth particle update using delta time
          p.update();

          const xOffset = (p.relativeX * currentLineSpread) - (currentLineSpread / 2);
          const particleX = xOffset + line.xOffset;
          
          // Frustum culling: skip particles outside visible area
          if (particleX < -currentLineSpread || particleX > window.innerWidth + currentLineSpread) {
            return;
          }
          
          // Particles maintain full opacity - no gradient or fade effects
          const finalAlpha = 1;

          ctx.beginPath();
          ctx.arc(particleX, p.y, particleRadius * mobileMultiplier, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(28, 165, 0, ${finalAlpha})`;
          ctx.fill();
        });

        // Remove lines that have moved off-screen to the right
        if (line.xOffset > window.innerWidth + currentLineSpread) {
          lines.splice(i, 1);
        }
      }

      // Always request next frame for smooth continuous animation
      if (!document.hidden && !isResizing) {
        animationFrameId = requestAnimationFrame(animate);
      }
    }

    // Resume animation when page becomes visible
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && lines.length > 0 && !isResizing) {
        lastTime = 0; // Reset time to prevent jump
        animationFrameId = requestAnimationFrame(animate);
      }
    });

    // Throttle resize events for better performance
    let resizeTimeout: ReturnType<typeof setTimeout> | null = null;
    window.addEventListener('resize', () => {
      // Cancel any pending resize
      if (resizeTimeout) {
        clearTimeout(resizeTimeout);
      }
      
      // Cancel animation during resize
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      
      // Debounce resize handler
      resizeTimeout = setTimeout(() => {
        resizeCanvas();
      }, 150); // Wait 150ms after resize stops
    });

    // Initial setup
    resizeCanvas();
    // Start animation with initial frame
    if (!document.hidden) {
      animationFrameId = requestAnimationFrame(animate);
    }
  });
</script>
