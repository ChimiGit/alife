</div>

<script>
  // --- Configuration Constants ---
  // All dynamic values are defined here for easy access and modification
  const CONFIG = {
    // Particle settings
    PARTICLE_RADIUS_MOBILE: 1.5,
    PARTICLE_RADIUS_DESKTOP: 1.7,
    BASE_LINE_SPEED: 2.0,
    BASE_LINE_SPREAD_MOBILE: 120,
    BASE_LINE_SPREAD_DESKTOP: 200,
    BASE_DENSITY: 2000,
    LINE_SEPARATION_MOBILE: 150,
    LINE_SEPARATION_DESKTOP: 210,
    MOBILE_MULTIPLIER: 0.6,
    DESKTOP_MULTIPLIER: 1,
    // Device detection thresholds
    MOBILE_BREAKPOINT: 768,
    LOW_END_MEMORY_THRESHOLD: 4, // GB
    LOW_END_CORES_THRESHOLD: 2,
    // Performance settings
    MAX_DPR: 2, // Maximum device pixel ratio
  };

  const initSlider1 = () => {
    // Set up the canvas and other variables
    const canvas = document.getElementById('particleCanvas');
    const ctx = canvas?.getContext('2d', { 
      alpha: false, // Opaque canvas = better performance
      desynchronized: true // Reduces latency
    });
      
    if (!ctx || !canvas) return;
    
    let lines = [];
    let animationFrameId = null;
    let isResizing = false;
    let lastTime = 0;
    let smoothedDelta = 1; // EMA-smoothed delta to ensure ultra-smooth motion
    let isVisible = false; // Track if this slider is visible
    const sliderId = 'slider1';
    const getActiveSliderId = () => (window).__activeSliderId as string | null;
    const setActiveSliderId = (id: string | null) => { (window).__activeSliderId = id; };
    const isActive = () => getActiveSliderId() === sliderId;
    const activateSelf = () => {
      if (!isActive()) {
        setActiveSliderId(sliderId);
        window.dispatchEvent(new CustomEvent('slider-activate', { detail: { id: sliderId } }));
      }
    };
    
    // Performance optimizations
    const isMobile = () => window.innerWidth <= CONFIG.MOBILE_BREAKPOINT;
    const isLowEnd = () => {
      const memory = navigator.deviceMemory;
      const cores = navigator.hardwareConcurrency;
      return (memory && memory < CONFIG.LOW_END_MEMORY_THRESHOLD) || (cores && cores <= CONFIG.LOW_END_CORES_THRESHOLD);
    };
    
    // Adaptive settings based on device capability
    const getSettings = () => {
      const mobile = isMobile();
      const lowEnd = isLowEnd();
      
      return {
        particleRadius: mobile ? CONFIG.PARTICLE_RADIUS_MOBILE : CONFIG.PARTICLE_RADIUS_DESKTOP,
        baseLineSpeed: CONFIG.BASE_LINE_SPEED,
        baseLineSpread: mobile ? CONFIG.BASE_LINE_SPREAD_MOBILE : CONFIG.BASE_LINE_SPREAD_DESKTOP,
        baseDensity: CONFIG.BASE_DENSITY,
        lineSeparation: mobile ? CONFIG.LINE_SEPARATION_MOBILE : CONFIG.LINE_SEPARATION_DESKTOP,
        mobileMultiplier: mobile ? CONFIG.MOBILE_MULTIPLIER : CONFIG.DESKTOP_MULTIPLIER,
        dpr: lowEnd ? 1 : Math.min(window.devicePixelRatio || 1, CONFIG.MAX_DPR)
      };
    };
    
    let settings = getSettings();

    function resizeCanvas() {
        if (!ctx || !canvas) return;
        
        isResizing = true;
        
        if (animationFrameId !== null) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
        
        // Refresh settings on resize
        settings = getSettings();
        const { dpr } = settings;
        
        const oldWidth = canvas.width > 0 ? canvas.width / dpr : window.innerWidth;
        const oldHeight = canvas.height > 0 ? canvas.height / dpr : window.innerHeight;
        
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        ctx.scale(dpr, dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;

        // Only scale existing lines if we have them and old dimensions are valid
        if (lines.length > 0 && oldWidth > 0 && oldHeight > 0) {
          const scaleX = window.innerWidth / oldWidth;
          const scaleY = window.innerHeight / oldHeight;
          
          lines.forEach((line) => {
            line.xOffset *= scaleX;
            line.particles.forEach((p) => {
              p.y *= scaleY;
            });
          });
        } else {
          // Initialize lines if we don't have any
          lines = [];
        }

        const centerX = isMobile() ? 0 : window.innerWidth / 2 + 40;
        const adjustedLineSeparation = settings.lineSeparation * settings.mobileMultiplier;
        const numRequiredLines = Math.ceil(window.innerWidth / adjustedLineSeparation) + 2;
        
        if (lines.length < numRequiredLines) {
          const linesToAdd = numRequiredLines - lines.length;
          for (let i = 0; i < linesToAdd; i++) {
            const line = createLine(1);
            const lastLine = lines[lines.length - 1];
            line.xOffset = lastLine ? lastLine.xOffset + adjustedLineSeparation : centerX;
            lines.push(line);
          }
        }
        
        if (lines.length > numRequiredLines + 2) {
          lines = lines.slice(0, numRequiredLines + 2);
        }

        isResizing = false;
        lastTime = 0;
        smoothedDelta = 1;
        
        // Only restart animation after resize if visible
        if (!document.hidden && isVisible) {
          animationFrameId = requestAnimationFrame(animate);
        }
    }

    // Use object literals instead of class for better performance
    function createParticle(relativeX, y, speedY) {
      return { relativeX, y, speedY };
    }
    
    function createLine(direction = 1) {
      const particles = [];
      const adjustedDensity = Math.floor(settings.baseDensity * settings.mobileMultiplier);
      
      // Pre-allocate array for better performance
      particles.length = adjustedDensity;
      
      for (let j = 0; j < adjustedDensity; j++) {
        const randomX = Math.pow(Math.random(), 0.5);
        const y = Math.random() * window.innerHeight;
        const speedY = (Math.random() - 0.5) * 1.0;
        particles[j] = createParticle(randomX, y, speedY);
      }

      return {
        xOffset: isMobile() ? 0 : window.innerWidth / 2 + 40,
        speed: settings.baseLineSpeed * direction,
        particles,
        opacity: 1,
        startX: isMobile() ? 0 : window.innerWidth / 2 + 40,
      };
    }

    function animate(currentTime = 0) {
      if (!ctx || !canvas) {
        return;
      }
      
      // Don't animate if not visible
      if (!isVisible || !isActive()) {
        animationFrameId = null;
        return;
      }
      
      if (isResizing) {
        animationFrameId = requestAnimationFrame(animate);
        return;
      }
      
      // Calculate delta time with smoothing to avoid micro-stutters
      const TARGET_FRAME_MS = 1000 / 60;
      const deltaMs = lastTime ? (currentTime - lastTime) : TARGET_FRAME_MS;
      lastTime = currentTime;
      const frameDelta = deltaMs / TARGET_FRAME_MS;
      // Exponential moving average to smooth out spikes
      smoothedDelta = smoothedDelta * 0.9 + frameDelta * 0.1;
      // Keep within a narrow band to avoid sudden accelerations/pauses
      const normalizedDelta = Math.min(1.25, Math.max(0.75, smoothedDelta));
      
      // Use fillRect instead of clearRect - slightly faster
      ctx.fillStyle = '#FBEC61';
      ctx.fillRect(0, 0, window.innerWidth, window.innerHeight);

      // Cache frequently used values
      const mobile = isMobile();
      const { mobileMultiplier } = settings;
      const adjustedLineSeparation = settings.lineSeparation * mobileMultiplier;
      const startX = mobile ? 0 : window.innerWidth / 2 + 40;
      const currentLineSpread = settings.baseLineSpread * mobileMultiplier;
      const particleSize = settings.particleRadius * mobileMultiplier;
      const canvasWidth = window.innerWidth;
      
      // Create new lines as we advance, keeping consistent spacing from startX
      if (lines.length === 0) {
        lines.push(createLine(1));
      } else {
        const lastLine = lines[lines.length - 1];
        const distanceFromStart = lastLine.xOffset - startX;
        if (distanceFromStart >= adjustedLineSeparation || (lines.length < 3 && distanceFromStart >= 0)) {
          const newLine = createLine(1);
          // Start the new line one separation to the left of the last line
          // so it glides in smoothly rather than popping at center
          newLine.xOffset = (lastLine ? lastLine.xOffset : startX) - adjustedLineSeparation;
          lines.push(newLine);
        }
      }

      // Set global alpha once for particles
      const centerX = mobile ? 0 : canvasWidth / 2 + 40;
      const fadeInStart = centerX - currentLineSpread;
      const fadeInEnd = centerX;
      const fadeOutStart = canvasWidth - currentLineSpread;
      const fadeOutEnd = canvasWidth;

      // Batch rendering - set fill style once
      ctx.fillStyle = 'rgba(28, 165, 0, 1)';

      for (let i = lines.length - 1; i >= 0; i--) {
        const line = lines[i];
        line.xOffset += line.speed * mobileMultiplier * normalizedDelta;

        // Calculate opacity once per line
        let lineOpacity = 1;
        if (!mobile) {
          if (line.xOffset < fadeInEnd) {
            lineOpacity = Math.max(0, Math.min(1, (line.xOffset - fadeInStart) / (fadeInEnd - fadeInStart)));
          } else if (line.xOffset > fadeOutStart) {
            lineOpacity = Math.max(0, 1 - ((line.xOffset - fadeOutStart) / (fadeOutEnd - fadeOutStart)));
          }
        }
        
        // Skip invisible lines or render otherwise (avoid continue)
        if (lineOpacity <= 0.01) {
          if (line.xOffset > canvasWidth + currentLineSpread) {
            lines.splice(i, 1);
          }
        } else {
          // Set alpha for this line
          ctx.globalAlpha = lineOpacity;
          
          const { particles } = line;
          const particleCount = particles.length;
          
          // Render particles - optimized loop
          for (let j = 0; j < particleCount; j++) {
            const p = particles[j];
            
            // Particles are static; skip per-frame vertical updates

            const xOffset = (p.relativeX * currentLineSpread) - (currentLineSpread / 2);
            const particleX = xOffset + line.xOffset;
            
            // Draw only when on-screen (avoid continue)
            if (particleX >= -currentLineSpread && particleX <= canvasWidth + currentLineSpread) {
              // Use arc for circles - fastest way to draw circles
              ctx.beginPath();
              ctx.arc(particleX, p.y, particleSize, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          // Recycle off-screen lines instead of removing them to maintain cadence
          if (line.xOffset > canvasWidth + currentLineSpread) {
            let maxOther = startX;
            for (let k = 0; k < lines.length; k++) {
              if (k !== i) {
                maxOther = Math.max(maxOther, lines[k].xOffset);
              }
            }
            line.xOffset = maxOther + adjustedLineSeparation;
          }
        }
      }

      // Reset global alpha
      ctx.globalAlpha = 1;

      if (!document.hidden && !isResizing) {
        animationFrameId = requestAnimationFrame(animate);
      }
    }

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && isVisible && isActive() && lines.length > 0 && !isResizing) {
        lastTime = 0;
        smoothedDelta = 1;
        if (animationFrameId === null) {
          animationFrameId = requestAnimationFrame(animate);
        }
      } else if (document.hidden && animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    });
    
    // Detect when this slider becomes visible/hidden
    const sliderContainer = canvas.closest('.slider-background');
    if (sliderContainer) {
      // Use MutationObserver to watch for display style changes
      const observer = new MutationObserver((_mutations) => {
        const computedStyle = window.getComputedStyle(sliderContainer);
        const nowVisible = computedStyle.display !== 'none';
        
        if (nowVisible !== isVisible) {
          isVisible = nowVisible;
          
          if (isVisible) {
            // Slider became visible - start animation
            lastTime = 0;
            smoothedDelta = 1;
            if (animationFrameId === null && !document.hidden) {
              activateSelf();
              resizeCanvas();
            }
          } else if (animationFrameId !== null) {
            // Slider became hidden - stop animation
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
          }
        }
      });
      
      observer.observe(sliderContainer, {
        attributes: true,
        attributeFilter: ['style', 'class']
      });
      
      // Check initial visibility
      const initialStyle = window.getComputedStyle(sliderContainer);
      isVisible = initialStyle.display !== 'none';
    } else {
      // Fallback if not in a slider container
      isVisible = true;
    }

    let resizeTimeout = null;
    window.addEventListener('resize', () => {
      if (resizeTimeout) {
        clearTimeout(resizeTimeout);
      }
      
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      
      resizeTimeout = setTimeout(() => {
        resizeCanvas();
      }, 150);
    });

    // Initial setup
    resizeCanvas();
    // Listen for global slider activation and pause if not active
    window.addEventListener('slider-activate', (e: any) => {
      const activatedId = e?.detail?.id as string | undefined;
      if (activatedId !== sliderId) {
        if (animationFrameId !== null) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      } else if (isVisible && !document.hidden) {
        // We just became active - ensure animation is running
        if (animationFrameId === null) {
          animationFrameId = requestAnimationFrame(animate);
        }
      }
    });
    if (isVisible) {
      activateSelf();
      if (isActive() && !document.hidden) {
        animationFrameId = requestAnimationFrame(animate);
      }
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlider1);
  } else {
    initSlider1();
  }
</script>